#!/usr/bin/env python3
"""
Inspect a STEP file and validate geometry.

Usage:
    python3 scripts/inspect <file.step>

Exit 0 if the STEP contains at least one closed solid body.
Exit 1 on any error or degenerate geometry.
Prints a structured report to stdout.
"""
import sys
from pathlib import Path

if len(sys.argv) < 2:
    print("Usage: python3 scripts/inspect <file.step>", file=sys.stderr)
    sys.exit(1)

step_file = Path(sys.argv[1]).resolve()
if not step_file.exists():
    print(f"ERROR: File not found: {step_file}", file=sys.stderr)
    sys.exit(1)

# ── Import STEP ───────────────────────────────────────────────────────────────

try:
    from build123d import import_step
except ImportError:
    print("ERROR: build123d not installed (pip install build123d)", file=sys.stderr)
    sys.exit(1)

try:
    shape = import_step(str(step_file))
except Exception as e:
    print(f"ERROR: Failed to import STEP: {e}", file=sys.stderr)
    sys.exit(1)

# ── Diff mode: `inspect NEW.step --diff OLD.step` → report what an edit changed ──
# Deterministic before→after delta (solids/faces/cyl/volume/bbox) so the agentic loop can
# confirm an EDIT did the intended thing (e.g. "added a hole" ⇒ ΔCyl +1, ΔVolume < 0) instead
# of relying on the vision critic to notice. Borrowed from earthtojake/text-to-cad `inspect diff`.
if "--diff" in sys.argv:
    di = sys.argv.index("--diff")
    if di + 1 >= len(sys.argv):
        print("ERROR: --diff needs a second STEP path (the OLD/before file)", file=sys.stderr)
        sys.exit(1)
    old_file = Path(sys.argv[di + 1]).resolve()
    if not old_file.exists():
        print(f"ERROR: diff file not found: {old_file}", file=sys.stderr)
        sys.exit(1)

    def _compact_facts(s):
        try:
            from build123d import GeomType
            cyl = len(s.faces().filter_by(GeomType.CYLINDER))
        except Exception:
            cyl = -1
        bb = s.bounding_box()
        return {"solids": len(s.solids()), "faces": len(s.faces()), "cyl": cyl,
                "vol": s.volume, "bbox": (bb.size.X, bb.size.Y, bb.size.Z)}

    try:
        a = _compact_facts(import_step(str(old_file)))   # OLD / before
    except Exception as e:
        print(f"ERROR: Failed to import OLD STEP: {e}", file=sys.stderr)
        sys.exit(1)
    b = _compact_facts(shape)                            # NEW / after (primary arg)
    print(f"DIFF: {old_file.name} -> {step_file.name}")
    print(f"ΔSolids: {b['solids'] - a['solids']:+d}  ({a['solids']} -> {b['solids']})")
    print(f"ΔFaces:  {b['faces'] - a['faces']:+d}  ({a['faces']} -> {b['faces']})")
    print(f"ΔCylindrical faces: {b['cyl'] - a['cyl']:+d}  ({a['cyl']} -> {b['cyl']})")
    print(f"ΔVolume: {b['vol'] - a['vol']:+.3f} mm³  ({a['vol']:.1f} -> {b['vol']:.1f})")
    print(f"ΔBbox:   {b['bbox'][0]-a['bbox'][0]:+.2f} x {b['bbox'][1]-a['bbox'][1]:+.2f} "
          f"x {b['bbox'][2]-a['bbox'][2]:+.2f} mm")
    print("OK")
    sys.exit(0)

# ── Checks ────────────────────────────────────────────────────────────────────

solids  = shape.solids()
shells  = shape.shells()
faces   = shape.faces()
edges   = shape.edges()
volume  = shape.volume
bbox    = shape.bounding_box()

# Centre of mass — gives the model a sense of where material actually sits
try:
    from build123d import CenterOf
    com = shape.center(CenterOf.MASS)
    com_str = f"{com.X:.2f}, {com.Y:.2f}, {com.Z:.2f}"
except Exception:
    com_str = "unknown"

# Classify curved faces so a deterministic gate can confirm holes/bores actually cut:
# a through-hole leaves a cylindrical face; a countersink leaves a conical face. A no-op
# subtraction that missed the solid leaves neither — caught without relying on the vision model.
cyl_faces = cone_faces = -1   # -1 = couldn't classify (older build123d) → gate skips this check
try:
    from build123d import GeomType
    cyl_faces  = len(faces.filter_by(GeomType.CYLINDER))
    cone_faces = len(faces.filter_by(GeomType.CONE))
except Exception:
    pass

# Classify each cylindrical HOLE as THROUGH or BLIND. A blind bore has a cylindrical face
# exactly like a through hole, so a naive cyl-face count cannot tell them apart (a blind
# 30mm bore passed the gate 3/3). Method, fully deterministic:
#   1. hole vs outer wall — is there material just OUTSIDE the cylinder? (wall has none)
#   2. through vs blind   — walk the cylinder axis across the part; a through hole has NO
#      material on its axis, a blind hole's uncut remainder leaves material on the axis.
through_holes = blind_holes = -1   # -1 = analysis unavailable → gate skips through-check
hole_report = []
hole_recs = []   # (radius, (px,py,pz), (dx,dy,dz), verdict) per hole face — feeds hole_groups
try:
    from build123d import Vertex, GeomType
    from OCP.BRepAdaptor import BRepAdaptor_Surface
    from OCP.GeomAbs import GeomAbs_Cylinder

    def _inside(x, y, z, tol=1e-6):
        return shape.distance_to(Vertex(x, y, z)) < tol

    _corners = [(X, Y, Z) for X in (bbox.min.X, bbox.max.X)
                          for Y in (bbox.min.Y, bbox.max.Y)
                          for Z in (bbox.min.Z, bbox.max.Z)]
    def _axis_extent(px, py, pz, dx, dy, dz):
        ts = [(cx - px) * dx + (cy - py) * dy + (cz - pz) * dz for (cx, cy, cz) in _corners]
        return min(ts), max(ts)

    through = blind = 0
    for f in faces.filter_by(GeomType.CYLINDER):
        ad = BRepAdaptor_Surface(f.wrapped)
        if ad.GetType() != GeomAbs_Cylinder:
            continue
        cyl = ad.Cylinder(); axis = cyl.Axis()
        loc = axis.Location(); d = axis.Direction()
        px, py, pz = loc.X(), loc.Y(), loc.Z()
        dx, dy, dz = d.X(), d.Y(), d.Z()
        r = cyl.Radius()
        tmin, tmax = _axis_extent(px, py, pz, dx, dy, dz)
        tmid = (tmin + tmax) / 2.0
        mx, my, mz = px + dx * tmid, py + dy * tmid, pz + dz * tmid
        # a unit vector perpendicular to the axis (Gram-Schmidt off a non-parallel seed)
        seed = (1.0, 0.0, 0.0) if abs(dx) < 0.9 else (0.0, 1.0, 0.0)
        dot = seed[0] * dx + seed[1] * dy + seed[2] * dz
        ux, uy, uz = seed[0] - dot * dx, seed[1] - dot * dy, seed[2] - dot * dz
        un = (ux * ux + uy * uy + uz * uz) ** 0.5 or 1.0
        ux, uy, uz = ux / un, uy / un, uz / un
        # step 1: material just OUTSIDE the cylinder? if not, this is the outer wall — skip.
        # Probe FOUR perpendicular directions, not one: a hole that breaches the outer wall
        # has void on the breach side, and a single probe there misclassified it as "wall".
        vx, vy, vz = (dy * uz - dz * uy), (dz * ux - dx * uz), (dx * uy - dy * ux)
        if not any(_inside(mx + sx * (r + 0.5), my + sy * (r + 0.5), mz + sz * (r + 0.5))
                   for (sx, sy, sz) in ((ux, uy, uz), (-ux, -uy, -uz),
                                        (vx, vy, vz), (-vx, -vy, -vz))):
            continue
        # step 2: walk the axis; any material on it ⇒ blind
        mat = sum(1 for i in range(25)
                  if _inside(px + dx * (t := tmin + (tmax - tmin) * i / 24.0),
                             py + dy * t, pz + dz * t))
        verdict = "THROUGH" if mat == 0 else "BLIND"
        through += (mat == 0); blind += (mat != 0)
        hole_report.append(f"r{r:.1f}@({px:.0f},{py:.0f},{pz:.0f}):{verdict}")
        hole_recs.append((r, (px, py, pz), (dx, dy, dz), verdict))
    through_holes, blind_holes = through, blind
except Exception as e:
    hole_report = [f"(hole analysis unavailable: {str(e)[:80]})"]

# ── Hole GROUPS (Ø × count × through × bolt-circle Ø) ───────────────────────────
# The unique-diameter "Bore diameters" line can't tell "one Ø20 bore + four Ø5 bolt holes"
# from "five Ø20 holes" (a real 7B failure the critic then passed). Group the HOLE-classified
# cylinders (outer walls already excluded above) by diameter, dedupe seam-split faces of the
# same physical hole (same axis line + radius), and report count / through-count / mean radial
# offset from the part centre (×2 = the measured bolt-circle Ø). Fully deterministic.
hole_groups: list[dict] = []
try:
    _uniq = []
    for (r, loc, d, verdict) in hole_recs:
        dup = False
        for (ur, uloc, ud, _uv) in _uniq:
            if abs(ur - r) > 1e-3:
                continue
            if abs(d[0]*ud[0] + d[1]*ud[1] + d[2]*ud[2]) < 0.999:
                continue
            dxp = (loc[0]-uloc[0], loc[1]-uloc[1], loc[2]-uloc[2])
            proj = dxp[0]*ud[0] + dxp[1]*ud[1] + dxp[2]*ud[2]
            perp = ((dxp[0]-proj*ud[0])**2 + (dxp[1]-proj*ud[1])**2 + (dxp[2]-proj*ud[2])**2) ** 0.5
            if perp < 0.1:   # same axis line + same radius ⇒ same hole (seam-split face)
                dup = True
                break
        if not dup:
            _uniq.append((r, loc, d, verdict))
    _cx = (bbox.min.X + bbox.max.X) / 2
    _cy = (bbox.min.Y + bbox.max.Y) / 2
    _cz = (bbox.min.Z + bbox.max.Z) / 2
    _bydia: dict = {}
    for (r, loc, d, verdict) in _uniq:
        _bydia.setdefault(round(2 * r, 1), []).append((loc, d, verdict))
    for dia in sorted(_bydia):
        items = _bydia[dia]
        offd = []
        for (loc, d, v) in items:
            vx, vy, vz = loc[0]-_cx, loc[1]-_cy, loc[2]-_cz
            proj = vx*d[0] + vy*d[1] + vz*d[2]
            offd.append((((vx-proj*d[0])**2 + (vy-proj*d[1])**2 + (vz-proj*d[2])**2) ** 0.5, v))
        # Sub-cluster by radial offset so a CENTRED bore and a same-Ø bolt circle report as two
        # groups (one Ø20 group spanning offsets 0+21 reported a bogus mean "circle Ø33.6").
        offd.sort()
        clusters: list[list] = [[offd[0]]]
        for pair in offd[1:]:
            if pair[0] - clusters[-1][-1][0] > max(2.0, 0.05 * pair[0]):
                clusters.append([pair])
            else:
                clusters[-1].append(pair)
        for cl in clusters:
            hole_groups.append({
                "d": dia, "n": len(cl),
                "through": sum(1 for (_o, v) in cl if v == "THROUGH"),
                "circle_d": round(2 * sum(o for (o, _v) in cl) / len(cl), 1),
            })
except Exception:
    hole_groups = []

# ── Feature dimensions (measure) ────────────────────────────────────────────────
# Deterministic readout of feature SIZES so the gate can check the brief's target dims (bore Ø,
# wall thickness) — not just the overall bounding box. Catches "right overall size, wrong feature
# size" (a Ø5.5 hole that came out Ø3, a 2mm wall that came out 1.2mm). Wall is an ESTIMATE and is
# only ever used as an advisory. Discipline from earthtojake/text-to-cad `inspect measure`.
bore_radii: list[float] = []
wall_candidates: list[float] = []
bore_orientations: list = []   # (diameter, "radial"|"axial") — feeds the general intent gate
try:
    from build123d import GeomType
    from OCP.BRepAdaptor import BRepAdaptor_Surface
    from OCP.GeomAbs import GeomAbs_Cylinder
    cyl_axes = []   # (px,py,pz, dx,dy,dz, r) for every cylindrical face
    for f in faces.filter_by(GeomType.CYLINDER):
        ad = BRepAdaptor_Surface(f.wrapped)
        if ad.GetType() != GeomAbs_Cylinder:
            continue
        cyl = ad.Cylinder(); ax = cyl.Axis(); loc = ax.Location(); d = ax.Direction()
        cyl_axes.append((loc.X(), loc.Y(), loc.Z(), d.X(), d.Y(), d.Z(), cyl.Radius()))
        bore_radii.append(cyl.Radius())

    # ── Bore ORIENTATION (radial vs axial) — general, drives the geometry-matches-intent gate. ──
    # The part's MAIN axis is the direction of its largest-radius cylindrical face (the outer body)
    # when it's round, else the longest bbox edge. A bore is AXIAL if its axis is parallel to that,
    # RADIAL if perpendicular (a hole through a side wall). No part-specific logic — the same rule
    # answers "is this a side bore?" for a piston, a shaft, or a manifold.
    _outer_r = max((c[6] for c in cyl_axes), default=0.0)
    # The largest cylinder is "the outer body wall" only when it really IS a body (radius a big
    # fraction of the part), not when the only cylinders are the holes themselves (a prismatic part
    # like a bracket, where every cylinder is a bore).
    _has_body = _outer_r > 0.4 * min(bbox.size.X, bbox.size.Y, bbox.size.Z)
    if _has_body:
        _main = max(cyl_axes, key=lambda c: c[6])      # round part → main axis = outer body axis
        mdx, mdy, mdz = _main[3], _main[4], _main[5]
    else:
        mdx, mdy, mdz = max([(bbox.size.X, (1, 0, 0)), (bbox.size.Y, (0, 1, 0)),
                             (bbox.size.Z, (0, 0, 1))])[1]   # prismatic → main axis = longest edge
    for c in cyl_axes:
        if _has_body and abs(c[6] - _outer_r) < 1e-6:
            continue
        dot = abs(c[3] * mdx + c[4] * mdy + c[5] * mdz)
        # A tilted bore near the old 0.7 cutoff flipped radial<->axial and hard-failed correct
        # parts; the middle band is now reported honestly so the gate can advise, not block.
        orient = "axial" if dot > 0.85 else ("radial" if dot < 0.55 else "ambiguous")
        bore_orientations.append((2 * c[6], orient))
    # Group cylinders that share an axis LINE (same direction + same line), then take only the
    # difference between CONSECUTIVE radii — that gap is the actual material wall between two
    # nested cylindrical surfaces (tube/skirt/round-cavity). Non-adjacent pairs (e.g. outer vs
    # cavity when a groove floor sits between) are NOT walls and would over-report thickness.
    groups: list[list] = []   # each: [dir/anchor signature, [radii]]
    for a in cyl_axes:
        placed = False
        for g in groups:
            b = g[0]
            parallel = abs(a[3]*b[3] + a[4]*b[4] + a[5]*b[5]) > 0.999
            dxp, dyp, dzp = a[0]-b[0], a[1]-b[1], a[2]-b[2]
            proj = dxp*b[3] + dyp*b[4] + dzp*b[5]
            perp = ((dxp-proj*b[3])**2 + (dyp-proj*b[4])**2 + (dzp-proj*b[5])**2) ** 0.5
            if parallel and perp < 0.5:
                g[1].append(a[6]); placed = True; break
        if not placed:
            groups.append([a, [a[6]]])
    for _, radii in groups:
        rs = sorted(set(round(r, 3) for r in radii))
        for k in range(1, len(rs)):
            wall_candidates.append(rs[k] - rs[k-1])
except Exception:
    pass
# Thin parallel planar pairs ⇒ box-wall / plate thickness. A wall's inner and outer faces are
# anti-parallel (normals point opposite ways) and close together relative to their size.
try:
    from build123d import GeomType
    pinfo = []
    for f in faces.filter_by(GeomType.PLANE):
        try:
            n = f.normal_at(); c = f.center()
            pinfo.append((n.X, n.Y, n.Z, c.X, c.Y, c.Z, f.area))
        except Exception:
            continue
    for i in range(len(pinfo)):
        for j in range(i + 1, len(pinfo)):
            a, b = pinfo[i], pinfo[j]
            if a[0]*b[0] + a[1]*b[1] + a[2]*b[2] > -0.999:   # not anti-parallel → not a wall pair
                continue
            if a[6] < 1.0 or b[6] < 1.0:                      # ignore slivers (groove-face noise)
                continue
            gap = abs((a[3]-b[3])*a[0] + (a[4]-b[4])*a[1] + (a[5]-b[5])*a[2])
            extent = min(a[6], b[6]) ** 0.5                   # against the SMALLER face's size
            if 0.1 < gap < 0.3 * extent:                      # thin relative to its own size
                wall_candidates.append(gap)
except Exception:
    pass

print(f"Solids:  {len(solids)}")
# Per-part breakdown for assemblies (multi-solid compounds): label + size + volume of each body,
# so the gate/critic can reason about the individual parts and their relative placement.
if len(solids) > 1:
    print(f"Parts ({len(solids)}):")
    for idx, s in enumerate(sorted(solids, key=lambda s: -s.volume), 1):
        try:
            lbl = (getattr(s, "label", "") or "").strip()
            sb = s.bounding_box()
            cen = sb.center()
            print(f"  [{idx}] {lbl or '(unlabeled)'}: "
                  f"{sb.size.X:.1f} x {sb.size.Y:.1f} x {sb.size.Z:.1f} mm  "
                  f"vol {s.volume:.0f} mm³  @ ({cen.X:.0f},{cen.Y:.0f},{cen.Z:.0f})")
        except Exception:
            continue
# ── Assembly sanity: fragmentation and interference ──────────────────────────
# Added 2026-07-30 after a user review of the mechanism run. Every part there was
# dimensionally clean and several were mechanically impossible: a connecting rod passing
# through the piston crown, impeller fins not attached to the hub, yoke arms floating in
# space. Those are not matters of taste — they are measurable, and the gate was blind to
# both. `parts` gives per-named-component solid counts (a component that is several
# disjoint bodies is not joined); `interference` gives pairwise overlap volume (two
# components that share space cannot be assembled).
part_report = []
interference = []
try:
    kids = list(getattr(shape, "children", []) or [])
    named = [k for k in kids if (getattr(k, "label", "") or "").strip()] or kids
    for k in named:
        try:
            ks = list(k.solids())
            # FACES per part matters: a threaded worm has dozens, a plain cylinder has three.
            # C05 (2026-07-30) swept a helical thread whose sweep() silently produced nothing,
            # so `core + thread` returned the bare core. The code read perfectly; the feature
            # was absent. Face count is the cheapest signal that an operation did nothing.
            part_report.append({"label": (getattr(k, "label", "") or "").strip() or "(unlabeled)",
                                "solids": len(ks),
                                "faces": len(k.faces()),
                                "volume": round(float(k.volume), 3)})
        except Exception:
            continue

    # MIN DISTANCE between parts: an assembly whose components merely sit side by side is not
    # assembled. C09's Geneva parts were individually correct and never engaged. Anything that
    # should mesh, seat or fasten must be touching (gap ~0) or nearly so.
    gaps = []
    if 2 <= len(named) <= 8:
        for i in range(len(named)):
            for j in range(i + 1, len(named)):
                try:
                    gaps.append([part_report[i]["label"], part_report[j]["label"],
                                 round(float(named[i].distance_to(named[j])), 3)])
                except Exception:
                    continue
    # Pairwise overlap. Boolean intersection is expensive, so only for a small roster.
    if 2 <= len(named) <= 8:
        for i in range(len(named)):
            for j in range(i + 1, len(named)):
                try:
                    ov = float((named[i] & named[j]).volume)
                except Exception:
                    continue
                if ov > 1.0:                      # mm^3; ignore numerical dust
                    interference.append([part_report[i]["label"] if i < len(part_report) else str(i),
                                         part_report[j]["label"] if j < len(part_report) else str(j),
                                         round(ov, 3)])
except Exception:
    pass

if part_report:
    print("Named parts: " + "; ".join(
        f"{p['label']}={p['solids']} solid{'s' if p['solids'] != 1 else ''}" for p in part_report))
    frag = [p for p in part_report if p["solids"] > 1]
    if frag:
        print("Fragmented parts (bodies NOT joined): " + "; ".join(
            f"{p['label']} is {p['solids']} disjoint bodies" for p in frag))
if 'gaps' in dir() and gaps:
    print("Part gaps: " + "; ".join(f"{a}<->{b}={g:.1f}mm" for a, b, g in gaps))
if interference:
    print("INTERFERENCE (parts share space, cannot be assembled): " + "; ".join(
        f"{a} & {b} overlap {v:.0f} mm³" for a, b, v in interference))

print(f"Shells:  {len(shells)}")
print(f"Faces:   {len(faces)}")
print(f"Cylindrical faces: {cyl_faces}")
print(f"Conical faces: {cone_faces}")
print(f"Through-holes: {through_holes}")
print(f"Blind-holes: {blind_holes}")
if hole_report:
    print(f"Hole detail: {'; '.join(hole_report)}")
if bore_radii:
    uniq_r = sorted({round(r, 2) for r in bore_radii})
    print(f"Bore diameters: {', '.join(f'{2*r:.2f}' for r in uniq_r)} mm  "
          f"(radii: {', '.join(f'{r:.2f}' for r in uniq_r)})")
if hole_groups:
    print("Hole groups: " + "; ".join(
        f"Ø{g['d']:g} ×{g['n']} ({g['through']} through"
        + (f", on circle Ø{g['circle_d']:g}" if g['n'] > 1 and g['circle_d'] > 1.0 else "")
        + ")" for g in hole_groups))
if wall_candidates:
    uniq_w = sorted({round(w, 2) for w in wall_candidates})
    print(f"Wall candidates (est): {', '.join(f'{w:.2f}' for w in uniq_w)} mm")
if bore_orientations:
    seen = sorted({(round(d, 1), o) for d, o in bore_orientations})
    print("Bore axes: " + "; ".join(f"Ø{d:g} {o}" for d, o in seen))
print(f"Edges:   {len(edges)}")
print(f"Volume:  {volume:.3f} mm³")
print(f"Bbox:    {bbox.size.X:.2f} x {bbox.size.Y:.2f} x {bbox.size.Z:.2f} mm  (X x Y x Z)")
print(f"Centre of mass: ({com_str}) mm")
# Machine-readable copy of everything above — the agent's parse_facts prefers this line,
# so the gate no longer depends on the exact wording of the human-readable prints.
import json as _json
print("FACTS_JSON: " + _json.dumps({
    "solids": len(solids), "shells": len(shells), "faces": len(faces),
    "cyl_faces": cyl_faces, "cone_faces": cone_faces,
    "through_holes": through_holes, "blind_holes": blind_holes,
    "bores": sorted({round(2 * r, 2) for r in bore_radii}),
    "hole_groups": hole_groups,
    "walls": sorted({round(w, 2) for w in wall_candidates}),
    "bore_axes": sorted({(round(d, 1), o) for d, o in bore_orientations}),
    "volume": round(volume, 3),
    "parts": part_report,
    "interference": interference,
    "part_gaps": (gaps if "gaps" in dir() else []),
    "bbox": [round(bbox.size.X, 2), round(bbox.size.Y, 2), round(bbox.size.Z, 2)],
}, separators=(",", ":"), default=list))
print(f"File:    {step_file.stat().st_size // 1024} KB")

errors = []

if len(solids) == 0:
    errors.append("No solid bodies — geometry is open or degenerate")

if volume < 0.001:
    errors.append(f"Volume is near-zero ({volume:.6f} mm³) — likely a surface, not a solid")

if any(d < 0.001 for d in [bbox.size.X, bbox.size.Y, bbox.size.Z]):
    errors.append(f"Bounding box has a near-zero dimension — check for collapsed geometry")

if errors:
    for err in errors:
        print(f"ERROR: {err}", file=sys.stderr)
    sys.exit(1)

if volume < 1.0:
    print(f"WARNING: Very small volume ({volume:.4f} mm³) — verify units are mm")

print("OK")
