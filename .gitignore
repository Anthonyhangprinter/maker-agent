__pycache__/
*.pyc
.bak-*/
benchmarks/results/*.log
# card runs: rows.jsonl + card.json/card.md + per-build artefacts, regenerated by scripts/run_card.py
benchmarks/results/card/
.pytest_cache/
.venv/
*.analysis.json
benchmarks/external/cache/
benchmarks/external/.venv-cq/
benchmarks/cadprompt/*
benchmarks/text2cadquery/*
!benchmarks/cadprompt/README.md
!benchmarks/text2cadquery/README.md
# owner-refs: materialised on demand from ~/CAD/references by lab/eval_round.py's
# materialize_owner_refs_suite(), same "gitignored, regenerated locally" convention as the
# two public suites above -- not a reproducibility record, just a local suite cache.
benchmarks/owner-refs/*
!benchmarks/owner-refs/README.md
benchmarks/external/benchcad/BenchCAD-main/
lab/.venv/
lab/runs/
lab/data/
unsloth_compiled_cache/
# Phase 3 data engine: lab/state/ is ledger/pairs/progress/refs -- regenerated by the
# harvest unit, not reproducibility records. specs.jsonl (the spec bank) and
# val_specs.json (the frozen validation split) ARE the reproducibility record and stay
# committed -- everything else under lab/state/ is git-ignored.
lab/state/*
!lab/state/specs.jsonl
!lab/state/val_specs.json

# round-2 training data: Claude-generated, kept local (terms + size)
lab/rounds/*/train.jsonl
lab/rounds/*/val.jsonl
